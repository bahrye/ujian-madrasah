<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pengaturan Server Ujian"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Ubah URL jika server ujian dipindahkan atau menggunakan IP lokal."
        android:textColor="@color/gray_text"
        android:textSize="12sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="URL Server Ujian">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etExamUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:text="https://ujian-madrasah.vercel.app" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvViolationStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Jumlah Pelanggaran Siswa: 0"
        android:textColor="@color/danger"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnResetViolations"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Reset Pelanggaran ke 0"
        android:textColor="@color/primary" />

    <Button
        android:id="@+id/btnCheckUpdate"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Periksa Pembaruan Aplikasi"
        android:textColor="@color/primary" />

</LinearLayout>
